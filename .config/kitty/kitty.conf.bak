# Font
# font_family      Iosevka Term
font_family      DejaVuSansM Nerd Font
# font_family      PlemolJP Console NF
# font_family     Fantasque Sans Mono
font_size 20.0

# Cursor
cursor_shape block
cursor_trail 1
cursor_trail_start_threshold 0
cursor_trail_decay 0.01 0.05
# cursor_shape_unfocused hollow 

# Padding (why weird value? consistency with foot)
window_margin_width 0
window_margin_width 11.75

# No stupid close confirmation
confirm_os_window_close 0

#Aesthetics
background_blur 10
background_opacity 0.9

shell_integration no-cursor

# Use fish shell
shell fish

# Copy
map ctrl+c    copy_or_interrupt

# Search
map ctrl+f   launch --location=hsplit --allow-remote-control kitty +kitten search.py @active-kitty-window-id
map kitty_mod+f   launch --location=hsplit --allow-remote-control kitty +kitten search.py @active-kitty-window-id

# Scroll & Zoom
map page_up    scroll_page_up
map page_down    scroll_page_down

map ctrl+plus  change_font_size all +1
map ctrl+equal  change_font_size all +1
map ctrl+kp_add  change_font_size all +1
map ctrl+minus       change_font_size all -1
map ctrl+underscore       change_font_size all -1
map ctrl+kp_subtract       change_font_size all -1
map ctrl+0 change_font_size all 0
map ctrl+kp_0 change_font_size all 0


#: Tab bar {{{

tab_bar_edge bottom

#: The edge to show the tab bar on, top or bottom.

tab_bar_margin_width 0

#: The margin to the left and right of the tab bar (in pts).

tab_bar_margin_height 6 0

#: The margin above and below the tab bar (in pts). The first number
#: is the margin between the edge of the OS Window and the tab bar.
#: The second number is the margin between the tab bar and the
#: contents of the current tab.
#
# tab_title_template "{index}"
 
tab_separator "|"
tab_bar_style separator
tab_title_max_length 0
tab_powerline_style slanted
tab_title_template " {f'{title[:4]}' if title.rindex(title[-1]) + 1 > 30 else (title.center(6) if (title.rindex(title[-1]) + 1) % 2 == 0 else title.center(5))}"

# active_tab_font_style   bold
# inactive_tab_font_style bold
# active_tab_foreground   #6c6c6c
# active_tab_background   #000000
# inactive_tab_foreground #303030
# inactive_tab_background #000000
# BEGIN_KITTY_THEME
# Tokyo Night
include current-theme.conf
# END_KITTY_THEME
